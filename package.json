{
  "name": "dsh-installed-inventory",
  "version": "0.5.1",
  "description": "已安装插件清单：首列包名、按作者分组、市场分类可折叠、市场式分页与返回顶部，安装时间双行徽章并可按分组排序，详情显示入口位置与界面文字特征。只读。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iflyg/dsh-installed-inventory.git"
  },
  "homepage": "https://github.com/iflyg/dsh-installed-inventory#readme",
  "bugs": {
    "url": "https://github.com/iflyg/dsh-installed-inventory/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/**/*.js",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/**/*.png",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "inventory",
    "audit"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    }
  }
}
